#!/usr/bin/make -f

export PYBUILD_NAME = packrat

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	install -D -m 0644 io.github.setzor.PackratBackup.desktop \
		debian/packrat/usr/share/applications/io.github.setzor.PackratBackup.desktop
	install -D -m 0644 io.github.setzor.PackratBackup.metainfo.xml \
		debian/packrat/usr/share/metainfo/io.github.setzor.PackratBackup.metainfo.xml
	install -D -m 0644 packrat/assets/packrat-mascot.svg \
		debian/packrat/usr/share/icons/hicolor/scalable/apps/io.github.setzor.PackratBackup.svg

override_dh_auto_test:
	# Tests need a Qt GUI environment; run via CI instead.
